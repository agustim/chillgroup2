import { Button, LineEdit, ListView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

// Toggle custom amb colors explícits — no depèn del tema del sistema
component DarkToggle {
    in-out property <bool> checked: false;
    in property <bool>     enabled: true;
    in property <string>   text;
    height: 28px;
    HorizontalBox {
        spacing: 10px; padding: 0px;
        Rectangle {
            width: 36px; height: 20px; border-radius: 10px;
            background: root.checked ? #89b4fa : #45475a;
            animate background { duration: 120ms; }
            Rectangle {
                x: root.checked ? parent.width - 18px : 2px;
                y: 2px; width: 16px; height: 16px; border-radius: 8px;
                background: #cdd6f4;
                animate x { duration: 120ms; }
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? #cdd6f4 : #585b70;
            font-size: 13px; vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => { if root.enabled { root.checked = !root.checked; } }
    }
}

export component SettingsWindow inherits Window {
    title: "Configuració — ChillGroup";
    width: 500px; height: 520px;
    background: #1e1e2e;
    in-out property <string> server-url;
    in-out property <string> vault-path;
    in-out property <bool>   notifications-enabled: true;
    in-out property <bool>   notifications-sound: true;
    // 0=Sistema, 1=Fosc, 2=Clar
    in-out property <int>    theme-index: 0;
    callback save();
    callback close();
    VerticalBox {
        padding: 24px; spacing: 14px;
        Text { text: "Configuració"; font-size: 20px; font-weight: 700; color: #cdd6f4; }

        Text { text: "URL del servidor"; font-size: 12px; color: #a6adc8; }
        LineEdit { text <=> root.server-url; placeholder-text: "https://..."; }

        Text { text: "Ubicació del vault"; font-size: 12px; color: #a6adc8; }
        LineEdit { text <=> root.vault-path; }

        Text { text: "Tema de l'aplicació"; font-size: 12px; color: #a6adc8; }
        HorizontalBox {
            spacing: 4px;
            for label[i] in ["Sistema", "Fosc", "Clar"]: Rectangle {
                height: 32px; border-radius: 6px;
                background: root.theme-index == i ? #89b4fa : #313244;
                Text {
                    text: label;
                    color: root.theme-index == i ? #1e1e2e : #a6adc8;
                    font-size: 13px; horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea { clicked => { root.theme-index = i; } }
            }
        }

        Text { text: "Notificacions"; font-size: 12px; color: #a6adc8; }
        DarkToggle { text: "Activar notificacions"; checked <=> root.notifications-enabled; }
        DarkToggle { text: "So"; checked <=> root.notifications-sound; enabled: root.notifications-enabled; }

        Rectangle { vertical-stretch: 1; }
        HorizontalBox {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Cancel·lar"; clicked => { root.close(); } }
            Button { text: "Desar"; primary: true; clicked => { root.save(); } }
        }
    }
}

export struct ServerItem  { id: string, name: string, initial: string }
export struct ChannelItem { id: string, name: string, channel-type: string, unread: bool, encrypted: bool }
export struct MessageItem { id: string, author: string, author-initial: string, content: string, timestamp: string, encrypted: bool }

export component AppWindow inherits Window {
    title: "ChillGroup";
    preferred-width: 1100px; preferred-height: 720px;
    min-width: 400px; min-height: 480px;
    background: #1e1e2e;

    // 0=sistema, 1=fosc, 2=clar — actualitza Palette.color-scheme quan canvia
    in-out property <int> app-theme-index: 0;
    changed app-theme-index => {
        if (root.app-theme-index == 1) { Palette.color-scheme = ColorScheme.dark; }
        else if (root.app-theme-index == 2) { Palette.color-scheme = ColorScheme.light; }
        else { Palette.color-scheme = ColorScheme.unknown; }
    }

    // --- Vault ---
    in-out property <bool>   vault-exists: false;
    in-out property <string> vault-passphrase;
    in-out property <string> vault-confirm;
    in-out property <string> vault-error;
    in-out property <bool>   vault-loading;
    in-out property <bool>   vault-open: false;
    callback open-vault();

    // --- Login ---
    in-out property <string> server-url: "https://";
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> error-message;
    in-out property <bool>   loading;
    callback login();
    callback open-settings();

    // --- Chat ---
    in-out property <bool>            logged-in: false;
    in-out property <[ServerItem]>    servers;
    in-out property <[ChannelItem]>   channels;
    in-out property <[MessageItem]>   messages;
    in-out property <string>          active-server-id;
    in-out property <string>          active-channel-id;
    in-out property <string>          active-channel-name;
    in-out property <string>          active-channel-type;
    in-out property <bool>            active-channel-encrypted: false;
    in-out property <string>          current-username;
    in-out property <string>          current-username-initial;
    in-out property <string>          message-draft;
    in-out property <bool>            in-voice-channel;
    in-out property <bool>            mic-muted;
    in-out property <bool>            deafened;
    in-out property <string>          status-text: "Connectat";
    callback select-server(string);
    callback select-channel(string, string);
    callback send-message(string);
    callback logout();
    callback join-voice();
    callback leave-voice();
    callback toggle-mute();
    callback toggle-deafen();

    // ── VAULT VIEW ───────────────────────────────────────────────────────────
    if !root.vault-open: HorizontalBox {
        alignment: center;
        VerticalBox {
            alignment: center;
            VerticalBox {
                padding: 40px; spacing: 16px; width: 360px;
                Text { text: "ChillGroup"; font-size: 28px; font-weight: 700; color: #cdd6f4; horizontal-alignment: center; }
                Text {
                    text: root.vault-exists ? "Introdueix la contrasenya del vault" : "Crea un vault per guardar la sessió";
                    font-size: 13px; color: #a6adc8; horizontal-alignment: center; wrap: word-wrap;
                }
                Text { text: "Contrasenya del vault"; font-size: 12px; color: #a6adc8; }
                LineEdit {
                    text <=> root.vault-passphrase;
                    placeholder-text: root.vault-exists ? "contrasenya" : "mínim 8 caràcters";
                    input-type: InputType.password; enabled: !root.vault-loading;
                    accepted => { if !root.vault-loading { root.open-vault(); } }
                }
                if !root.vault-exists: Text { text: "Confirmar contrasenya"; font-size: 12px; color: #a6adc8; }
                if !root.vault-exists: LineEdit {
                    text <=> root.vault-confirm;
                    placeholder-text: "repeteix la contrasenya";
                    input-type: InputType.password; enabled: !root.vault-loading;
                    accepted => { if !root.vault-loading { root.open-vault(); } }
                }
                if root.vault-error != "": Text { text: root.vault-error; color: #f38ba8; font-size: 12px; wrap: word-wrap; }
                Button {
                    text: root.vault-loading ? "Obrint..." : (root.vault-exists ? "Obrir vault" : "Crear vault");
                    primary: true; enabled: !root.vault-loading && root.vault-passphrase != "";
                    clicked => { root.open-vault(); }
                }
            }
        }
    }

    // ── LOGIN VIEW ───────────────────────────────────────────────────────────
    if root.vault-open && !root.logged-in: HorizontalBox {
        alignment: center;
        VerticalBox {
            alignment: center;
            VerticalBox {
                padding: 40px; spacing: 16px; width: 360px;
                Text { text: "ChillGroup"; font-size: 28px; font-weight: 700; color: #cdd6f4; horizontal-alignment: center; }
                Text { text: "Servidor"; font-size: 12px; color: #a6adc8; }
                LineEdit { text <=> root.server-url; placeholder-text: "https://chillgroup.example.com"; enabled: !root.loading; }
                Text { text: "Usuari"; font-size: 12px; color: #a6adc8; }
                LineEdit { text <=> root.username; placeholder-text: "nom d'usuari"; enabled: !root.loading; }
                Text { text: "Contrasenya"; font-size: 12px; color: #a6adc8; }
                LineEdit { text <=> root.password; placeholder-text: "contrasenya"; input-type: InputType.password; enabled: !root.loading; accepted => { root.login(); } }
                if root.error-message != "": Text { text: root.error-message; color: #f38ba8; font-size: 12px; wrap: word-wrap; }
                Button { text: root.loading ? "Connectant..." : "Entrar"; enabled: !root.loading && root.username != "" && root.password != ""; clicked => { root.login(); } primary: true; }
                Button { text: "Configuració..."; clicked => { root.open-settings(); } }
            }
        }
    }

    // ── CHAT VIEW ────────────────────────────────────────────────────────────
    if root.vault-open && root.logged-in: HorizontalBox {
        spacing: 0px; padding: 0px;

        // Server sidebar
        Rectangle {
            width: 72px; background: #181825;
            VerticalBox {
                padding: 8px; spacing: 6px; alignment: start;
                for server in root.servers: Rectangle {
                    width: 48px; height: 48px;
                    border-radius: active-server-id == server.id ? 16px : 24px;
                    background: active-server-id == server.id ? #89b4fa : #313244;
                    Text {
                        text: server.initial;
                        color: active-server-id == server.id ? #1e1e2e : #cdd6f4;
                        font-size: 18px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.select-server(server.id); } }
                }
            }
        }

        // Channel sidebar
        Rectangle {
            width: 220px; background: #181825;
            VerticalBox {
                spacing: 0px; padding: 0px;
                Rectangle {
                    height: 48px; background: #1e1e2e;
                    Text { x: 16px; text: "Canals"; font-size: 14px; font-weight: 700; color: #cdd6f4; vertical-alignment: center; }
                }
                ListView {
                    for ch in root.channels: Rectangle {
                        height: 36px;
                        background: active-channel-id == ch.id ? #313244 : transparent;
                        border-radius: 6px;
                        HorizontalBox {
                            padding-left: 12px; spacing: 6px;
                            Text { text: ch.channel-type == "voice" ? "♪" : "#"; font-size: 14px; color: #6c7086; width: 16px; }
                            Text { text: ch.name; font-size: 14px; color: ch.unread ? #cdd6f4 : #a6adc8; font-weight: ch.unread ? 700 : 400; }
                        }
                        TouchArea { clicked => { root.select-channel(ch.id, ch.channel-type); } }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                Rectangle {
                    height: 52px; background: #11111b;
                    HorizontalBox {
                        padding: 8px; spacing: 8px;
                        Rectangle {
                            width: 32px; height: 32px; border-radius: 16px; background: #89b4fa;
                            Text { text: root.current-username-initial; color: #1e1e2e; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: root.current-username; color: #cdd6f4; font-size: 13px; horizontal-stretch: 1; }
                        Button { text: "⚙"; clicked => { root.open-settings(); } }
                        Button { text: "↩"; clicked => { root.logout(); } }
                    }
                }
            }
        }

        // Main content
        Rectangle {
            horizontal-stretch: 1; background: #1e1e2e;
            VerticalBox {
                spacing: 0px; padding: 0px;

                Rectangle {
                    height: 48px; background: #1e1e2e;
                    HorizontalBox {
                        padding-left: 16px; padding-right: 8px; spacing: 8px;
                        Text { text: active-channel-type == "voice" ? "♪" : "#"; font-size: 16px; color: #6c7086; }
                        Text { text: root.active-channel-name != "" ? root.active-channel-name : "Selecciona un canal"; font-size: 16px; font-weight: 600; color: #cdd6f4; }
                        Rectangle { horizontal-stretch: 1; }
                        if root.active-channel-type == "voice": HorizontalBox {
                            spacing: 4px;
                            if !root.in-voice-channel: Button { text: "Entrar"; primary: true; clicked => { root.join-voice(); } }
                            if root.in-voice-channel: Button { text: root.mic-muted ? "Activar mic" : "Silenciar"; clicked => { root.toggle-mute(); } }
                            if root.in-voice-channel: Button { text: root.deafened ? "Activar so" : "Ensordir"; clicked => { root.toggle-deafen(); } }
                            if root.in-voice-channel: Button { text: "Sortir"; clicked => { root.leave-voice(); } }
                        }
                    }
                }

                if root.active-channel-encrypted: Rectangle {
                    vertical-stretch: 1; background: #181825;
                    VerticalBox {
                        alignment: center; spacing: 8px;
                        Text { text: "🔒"; font-size: 32px; horizontal-alignment: center; }
                        Text { text: "Canal xifrat (E2EE)"; font-size: 16px; font-weight: 700; color: #cdd6f4; horizontal-alignment: center; }
                        Text { text: "El client natiu no suporta E2EE encara.\nUsa el client web per aquest canal."; color: #6c7086; font-size: 13px; horizontal-alignment: center; }
                    }
                }

                if root.active-channel-type == "text" && !root.active-channel-encrypted: ListView {
                    vertical-stretch: 1;
                    for msg in root.messages: Rectangle {
                        height: 58px; background: transparent;
                        HorizontalBox {
                            padding-left: 16px; padding-right: 16px; spacing: 12px;
                            Rectangle {
                                width: 36px; height: 36px; border-radius: 18px; background: #313244; y: 10px;
                                Text { text: msg.author-initial; color: #cdd6f4; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                            }
                            VerticalBox {
                                spacing: 2px; padding-top: 8px;
                                HorizontalBox {
                                    spacing: 8px;
                                    Text { text: msg.author; font-weight: 700; color: #89b4fa; font-size: 14px; }
                                    Text { text: msg.timestamp; color: #585b70; font-size: 11px; vertical-alignment: center; }
                                }
                                Text { text: msg.content; color: #cdd6f4; font-size: 14px; wrap: word-wrap; }
                            }
                        }
                    }
                }

                if root.active-channel-type == "voice" && !root.active-channel-encrypted: Rectangle {
                    vertical-stretch: 1; background: #181825;
                    Text {
                        text: root.in-voice-channel ? "En canal de veu" : "Prem 'Entrar' per unir-te al canal de veu";
                        color: #6c7086; font-size: 16px; horizontal-alignment: center; vertical-alignment: center;
                    }
                }

                if root.active-channel-type == "text" && !root.active-channel-encrypted: Rectangle {
                    height: 56px;
                    HorizontalBox {
                        padding: 8px; spacing: 8px;
                        LineEdit {
                            horizontal-stretch: 1;
                            text <=> root.message-draft;
                            placeholder-text: "Escriu un missatge...";
                            enabled: root.active-channel-id != "";
                            accepted => {
                                if root.message-draft != "" {
                                    root.send-message(root.message-draft);
                                    root.message-draft = "";
                                }
                            }
                        }
                        Button {
                            text: "Enviar"; primary: true;
                            enabled: root.message-draft != "" && root.active-channel-id != "";
                            clicked => { root.send-message(root.message-draft); root.message-draft = ""; }
                        }
                    }
                }

                Rectangle {
                    height: 22px; background: #11111b;
                    Text { x: 8px; text: root.status-text; font-size: 11px; color: #6c7086; vertical-alignment: center; }
                }
            }
        }
    }
}

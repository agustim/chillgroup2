import { Button, LineEdit, ListView, ScrollView, VerticalBox, HorizontalBox, Palette } from "std-widgets.slint";

component DarkToggle {
    in-out property <bool> checked: false;
    in property <bool>     enabled: true;
    in property <string>   text;
    height: 28px;
    HorizontalBox {
        spacing: 10px; padding: 0px;
        Rectangle {
            width: 36px; height: 20px; border-radius: 10px;
            background: root.checked ? Palette.accent-background : Palette.selection-background;
            animate background { duration: 120ms; }
            Rectangle {
                x: root.checked ? parent.width - 18px : 2px;
                y: 2px; width: 16px; height: 16px; border-radius: 8px;
                background: Palette.foreground;
                animate x { duration: 120ms; }
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? Palette.foreground : Palette.border;
            font-size: 13px; vertical-alignment: center;
        }
    }
    TouchArea {
        clicked => { if root.enabled { root.checked = !root.checked; } }
    }
}

export component SettingsWindow inherits Window {
    title: "Configuració — ChillGroup";
    width: 500px; height: 520px;
    background: Palette.background;
    in-out property <string> server-url;
    in-out property <string> vault-path;
    in-out property <bool>   notifications-enabled: true;
    in-out property <bool>   notifications-sound: true;
    in-out property <int>    theme-index: 0;
    callback theme-preview(int);
    callback save();
    callback close();
    VerticalBox {
        padding: 24px; spacing: 14px;
        Text { text: "Configuració"; font-size: 20px; font-weight: 700; color: Palette.foreground; }

        Text { text: "URL del servidor"; font-size: 12px; color: Palette.border; }
        LineEdit { text <=> root.server-url; placeholder-text: "https://..."; }

        Text { text: "Ubicació del vault"; font-size: 12px; color: Palette.border; }
        LineEdit { text <=> root.vault-path; }

        Text { text: "Tema de l'aplicació"; font-size: 12px; color: Palette.border; }
        HorizontalBox {
            spacing: 4px;
            for label[i] in ["Sistema", "Fosc", "Clar"]: Rectangle {
                height: 32px; border-radius: 6px;
                background: root.theme-index == i ? Palette.accent-background : Palette.selection-background;
                Text {
                    text: label;
                    color: root.theme-index == i ? Palette.accent-foreground : Palette.foreground;
                    font-size: 13px; horizontal-alignment: center; vertical-alignment: center;
                }
                TouchArea { clicked => { root.theme-index = i; root.theme-preview(i); } }
            }
        }

        Text { text: "Notificacions"; font-size: 12px; color: Palette.border; }
        DarkToggle { text: "Activar notificacions"; checked <=> root.notifications-enabled; }
        DarkToggle { text: "So"; checked <=> root.notifications-sound; enabled: root.notifications-enabled; }

        Rectangle { vertical-stretch: 1; }
        HorizontalBox {
            spacing: 8px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Cancel·lar"; clicked => { root.close(); } }
            Button { text: "Desar"; primary: true; clicked => { root.save(); } }
        }
    }
}

// Voice control emoji button (mic, deafen, camera, screen, leave)
component VoiceBtn {
    in property <bool> active: false;
    in property <bool> danger: false;   // danger=true → red when inactive (mic, deafen)
    in property <string> icon;
    callback clicked();

    preferred-width: 38px;
    preferred-height: 38px;

    ta := TouchArea { clicked => { root.clicked(); } }
    Rectangle {
        border-radius: 8px;
        background: ta.pressed
            ? #222
            : root.active ? #27ae60
            : root.danger ? #c0392b
            : #555;
        animate background { duration: 80ms; }
        Text {
            text: root.icon;
            font-size: 20px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export struct ServerItem  { id: string, name: string, initial: string }
export struct ChannelItem { id: string, name: string, channel-type: string, unread: bool, encrypted: bool, encryption-type: string, permission-level: int }
export struct MessageItem { id: string, author: string, author-initial: string, content: string, timestamp: string, encrypted: bool, key-version: int, expires-at: string }
export struct VoiceParticipant { user-id: string, username: string, initial: string, is-speaking: bool, is-suppressed: bool }
// Sidebar presence entries (one row per user per channel)
export struct VoiceSidebarEntry { channel-id: string, username: string, initial: string, is-speaking: bool, is-suppressed: bool }

export component AppWindow inherits Window {
    title: "ChillGroup";
    preferred-width: 1100px; preferred-height: 720px;
    min-width: 400px; min-height: 480px;
    background: Palette.background;

    in-out property <int> app-theme-index: 1;
    init => {
        if (root.app-theme-index == 1) { Palette.color-scheme = ColorScheme.dark; }
        else if (root.app-theme-index == 2) { Palette.color-scheme = ColorScheme.light; }
        else { Palette.color-scheme = ColorScheme.unknown; }
    }
    changed app-theme-index => {
        if (root.app-theme-index == 1) { Palette.color-scheme = ColorScheme.dark; }
        else if (root.app-theme-index == 2) { Palette.color-scheme = ColorScheme.light; }
        else { Palette.color-scheme = ColorScheme.unknown; }
    }

    // --- Vault ---
    in-out property <bool>   vault-exists: false;
    in-out property <string> vault-passphrase;
    in-out property <string> vault-confirm;
    in-out property <string> vault-error;
    in-out property <bool>   vault-loading;
    in-out property <bool>   vault-open: false;
    callback open-vault();

    // --- Login ---
    in-out property <string> server-url: "https://";
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> error-message;
    in-out property <bool>   loading;
    callback login();
    callback open-settings();

    // --- Chat ---
    in-out property <bool>            logged-in: false;
    in-out property <[ServerItem]>    servers;
    in-out property <[ChannelItem]>   channels;
    in-out property <[MessageItem]>   messages;
    in-out property <string>          active-server-id;
    in-out property <string>          active-channel-id;
    in-out property <string>          active-channel-name;
    in-out property <string>          active-channel-type;
    in-out property <bool>            active-channel-encrypted: false;
    in-out property <string>          active-channel-encryption-type;
    in-out property <int>             active-channel-ttl: 0;
    in-out property <int>             active-channel-key-version: 0;
    in-out property <length>          msg-viewport-y: 0px;
    in-out property <bool>            scroll-to-bottom: false;
    in-out property <string>          current-username;
    in-out property <string>          current-username-initial;
    in-out property <string>          message-draft;
    in-out property <bool>            in-voice-channel;
    in-out property <bool>            mic-muted;
    in-out property <bool>            deafened;
    in-out property <bool>            camera-on;
    in-out property <bool>            screen-sharing;
    in-out property <[VoiceParticipant]>     voice-participants;
    in-out property <[VoiceSidebarEntry]>    voice-sidebar-presences;
    in-out property <string>          status-text: "Connectat";
    callback select-server(string);
    callback select-channel(string, string);
    callback send-message(string);
    callback logout();
    callback join-voice();
    callback leave-voice();
    callback toggle-mute();
    callback toggle-deafen();
    callback toggle-camera();
    callback toggle-screen-share();
    callback repair-channel();
    callback rotate-channel-key();

    // ── VAULT VIEW ───────────────────────────────────────────────────────────
    if !root.vault-open: HorizontalBox {
        alignment: center;
        VerticalBox {
            alignment: center;
            VerticalBox {
                padding: 40px; spacing: 16px; width: 360px;
                Text { text: "ChillGroup"; font-size: 28px; font-weight: 700; color: Palette.foreground; horizontal-alignment: center; }
                Text {
                    text: root.vault-exists ? "Introdueix la contrasenya del vault" : "Crea un vault per guardar la sessió";
                    font-size: 13px; color: Palette.border; horizontal-alignment: center; wrap: word-wrap;
                }
                Text { text: "Contrasenya del vault"; font-size: 12px; color: Palette.border; }
                LineEdit {
                    text <=> root.vault-passphrase;
                    placeholder-text: root.vault-exists ? "contrasenya" : "mínim 8 caràcters";
                    input-type: InputType.password; enabled: !root.vault-loading;
                    accepted => { if !root.vault-loading { root.open-vault(); } }
                }
                if !root.vault-exists: Text { text: "Confirmar contrasenya"; font-size: 12px; color: Palette.border; }
                if !root.vault-exists: LineEdit {
                    text <=> root.vault-confirm;
                    placeholder-text: "repeteix la contrasenya";
                    input-type: InputType.password; enabled: !root.vault-loading;
                    accepted => { if !root.vault-loading { root.open-vault(); } }
                }
                if root.vault-error != "": Text { text: root.vault-error; color: #f38ba8; font-size: 12px; wrap: word-wrap; }
                Button {
                    text: root.vault-loading ? "Obrint..." : (root.vault-exists ? "Obrir vault" : "Crear vault");
                    primary: true; enabled: !root.vault-loading && root.vault-passphrase != "";
                    clicked => { root.open-vault(); }
                }
            }
        }
    }

    // ── LOGIN VIEW ───────────────────────────────────────────────────────────
    if root.vault-open && !root.logged-in: HorizontalBox {
        alignment: center;
        VerticalBox {
            alignment: center;
            VerticalBox {
                padding: 40px; spacing: 16px; width: 360px;
                Text { text: "ChillGroup"; font-size: 28px; font-weight: 700; color: Palette.foreground; horizontal-alignment: center; }
                Text { text: "Servidor"; font-size: 12px; color: Palette.border; }
                LineEdit { text <=> root.server-url; placeholder-text: "https://chillgroup.example.com"; enabled: !root.loading; }
                Text { text: "Usuari"; font-size: 12px; color: Palette.border; }
                LineEdit { text <=> root.username; placeholder-text: "nom d'usuari"; enabled: !root.loading; }
                Text { text: "Contrasenya"; font-size: 12px; color: Palette.border; }
                LineEdit { text <=> root.password; placeholder-text: "contrasenya"; input-type: InputType.password; enabled: !root.loading; accepted => { root.login(); } }
                if root.error-message != "": Text { text: root.error-message; color: #f38ba8; font-size: 12px; wrap: word-wrap; }
                Button { text: root.loading ? "Connectant..." : "Entrar"; enabled: !root.loading && root.username != "" && root.password != ""; clicked => { root.login(); } primary: true; }
                Button { text: "Configuració..."; clicked => { root.open-settings(); } }
            }
        }
    }

    // ── CHAT VIEW ────────────────────────────────────────────────────────────
    if root.vault-open && root.logged-in: HorizontalBox {
        spacing: 0px; padding: 0px;

        // Server sidebar — darkest
        Rectangle {
            width: 72px; background: Palette.background;
            VerticalBox {
                padding: 8px; spacing: 6px; alignment: start;
                for server in root.servers: Rectangle {
                    width: 48px; height: 48px;
                    border-radius: active-server-id == server.id ? 16px : 24px;
                    background: active-server-id == server.id ? Palette.accent-background : Palette.selection-background;
                    Text {
                        text: server.initial;
                        color: active-server-id == server.id ? Palette.accent-foreground : Palette.foreground;
                        font-size: 18px; font-weight: 700;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    TouchArea { clicked => { root.select-server(server.id); } }
                }
            }
        }

        // Channel sidebar — dark
        Rectangle {
            width: 220px; background: Palette.alternate-background;
            VerticalBox {
                spacing: 0px; padding: 0px;
                Rectangle {
                    height: 48px; background: Palette.alternate-background;
                    Text { x: 16px; text: "Canals"; font-size: 14px; font-weight: 700; color: Palette.foreground; vertical-alignment: center; }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 0px; padding: 2px; alignment: start;
                        for ch in root.channels: VerticalLayout {
                            spacing: 0px;
                            // ── Channel row ─────────────────────────────
                            Rectangle {
                                height: 36px;
                                background: active-channel-id == ch.id ? Palette.selection-background : transparent;
                                border-radius: 6px;
                                HorizontalBox {
                                    padding-left: 12px; padding-right: 4px; spacing: 4px;
                                    Text {
                                        text: ch.channel-type == "voice" ? "♪" : "#";
                                        font-size: 14px; color: Palette.border; width: 14px;
                                    }
                                    Text {
                                        text: ch.name;
                                        font-size: 14px;
                                        color: ch.unread ? Palette.foreground : Palette.border;
                                        font-weight: ch.unread ? 700 : 400;
                                        horizontal-stretch: 1;
                                    }
                                    if ch.encryption-type == "symmetric": Text {
                                        text: "🔑"; font-size: 11px; vertical-alignment: center;
                                    }
                                    if ch.encryption-type == "asymmetric": Text {
                                        text: "🔒"; font-size: 11px; vertical-alignment: center;
                                    }
                                    if ch.unread: Rectangle {
                                        width: 8px; height: 8px; border-radius: 4px;
                                        background: Palette.accent-background;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.select-channel(ch.id, ch.channel-type);
                                        if ch.channel-type == "voice" { root.join-voice(); }
                                    }
                                }
                            }
                            // ── Voice participants (sidebar presence) ───
                            if ch.channel-type == "voice": VerticalLayout {
                                spacing: 0px;
                                for p in root.voice-sidebar-presences: Rectangle {
                                    visible: p.channel-id == ch.id;
                                    height: p.channel-id == ch.id ? 26px : 0px;
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 30px; padding-right: 8px; spacing: 6px; alignment: start;
                                        Rectangle {
                                            width: 18px; height: 18px; border-radius: 9px;
                                            background: p.is-speaking ? #22c55e : Palette.border;
                                            Text {
                                                text: p.initial;
                                                color: white; font-size: 10px; font-weight: 700;
                                                horizontal-alignment: center; vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: p.username; font-size: 12px;
                                            color: p.is-speaking ? #22c55e : Palette.foreground;
                                            vertical-alignment: center; horizontal-stretch: 1;
                                        }
                                        if p.is-suppressed: Text { text: "🔇"; font-size: 10px; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }

                // ── Voice controls (bottom of sidebar) ──────────────────────
                if root.in-voice-channel: Rectangle {
                    height: 52px; background: #1a1a2e;
                    HorizontalBox {
                        padding-left: 6px; padding-right: 6px; padding-top: 7px; padding-bottom: 7px;
                        spacing: 4px; alignment: center;
                        VoiceBtn {
                            icon: "🎤"; danger: true; active: !root.mic-muted;
                            clicked => { root.toggle-mute(); }
                        }
                        VoiceBtn {
                            icon: "🔊"; danger: true; active: !root.deafened;
                            clicked => { root.toggle-deafen(); }
                        }
                        VoiceBtn {
                            icon: "🎥"; active: root.camera-on;
                            clicked => { root.toggle-camera(); }
                        }
                        VoiceBtn {
                            icon: "🖥️"; active: root.screen-sharing;
                            clicked => { root.toggle-screen-share(); }
                        }
                        VoiceBtn {
                            icon: "🎬"; active: false;
                            clicked => { }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VoiceBtn {
                            icon: "✕";
                            clicked => { root.leave-voice(); }
                        }
                    }
                }

                Rectangle {
                    height: 52px; background: Palette.background;
                    HorizontalBox {
                        padding: 8px; spacing: 8px;
                        Rectangle {
                            width: 32px; height: 32px; border-radius: 16px; background: Palette.accent-background;
                            Text { text: root.current-username-initial; color: Palette.accent-foreground; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: root.current-username; color: Palette.foreground; font-size: 13px; horizontal-stretch: 1; }
                        Button { text: "⚙"; clicked => { root.open-settings(); } }
                        Button { text: "↩"; clicked => { root.logout(); } }
                    }
                }
            }
        }

        // Main content — lighter than sidebars
        Rectangle {
            horizontal-stretch: 1; background: Palette.alternate-background;
            VerticalBox {
                spacing: 0px; padding: 0px;

                // Top channel header — slightly distinct
                Rectangle {
                    height: 48px; background: Palette.alternate-background;
                    HorizontalBox {
                        padding-left: 16px; padding-right: 8px; spacing: 8px;
                        Text { text: active-channel-type == "voice" ? "♪" : "#"; font-size: 16px; color: Palette.border; }
                        Text { text: root.active-channel-name != "" ? root.active-channel-name : "Selecciona un canal"; font-size: 16px; font-weight: 600; color: Palette.foreground; }
                        if root.active-channel-encryption-type == "symmetric": Text { text: "🔑"; font-size: 13px; vertical-alignment: center; }
                        if root.active-channel-encryption-type == "asymmetric": Text { text: "🔒"; font-size: 13px; vertical-alignment: center; }
                        if root.active-channel-ttl > 0: Text { text: "⏱"; font-size: 13px; vertical-alignment: center; color: Palette.border; }
                        Rectangle { horizontal-stretch: 1; }
                        if root.active-channel-encryption-type == "asymmetric": Button {
                            text: "Arreglar Claus"; height: 28px;
                            clicked => { root.repair-channel(); }
                        }
                        if root.active-channel-encryption-type == "asymmetric" || root.active-channel-encryption-type == "symmetric": Button {
                            text: "Rotar Clau"; height: 28px;
                            clicked => { root.rotate-channel-key(); }
                        }
                    }
                }

                if root.active-channel-encrypted: Rectangle {
                    vertical-stretch: 1; background: Palette.background;
                    VerticalBox {
                        alignment: center; spacing: 8px;
                        if root.active-channel-encryption-type == "asymmetric": Text {
                            text: "🔒"; font-size: 32px; horizontal-alignment: center;
                        }
                        if root.active-channel-encryption-type == "asymmetric": Text {
                            text: "Esperant distribució de claus";
                            font-size: 16px; font-weight: 700; color: Palette.foreground; horizontal-alignment: center;
                        }
                        if root.active-channel-encryption-type == "asymmetric": Text {
                            text: "Un altre dispositiu connectat amb accés al canal ha de distribuir la clau.\nAlternativament, prem 'Arreglar Claus' si tens accés.";
                            color: Palette.border; font-size: 13px; horizontal-alignment: center;
                        }
                        if root.active-channel-encryption-type != "asymmetric": Text {
                            text: "🔑"; font-size: 32px; horizontal-alignment: center;
                        }
                        if root.active-channel-encryption-type != "asymmetric": Text {
                            text: "Canal xifrat (E2EE)";
                            font-size: 16px; font-weight: 700; color: Palette.foreground; horizontal-alignment: center;
                        }
                        if root.active-channel-encryption-type != "asymmetric": Text {
                            text: "No s'ha pogut obtenir la clau de xifrat.";
                            color: Palette.border; font-size: 13px; horizontal-alignment: center;
                        }
                    }
                }

                if root.active-channel-type == "text" && !root.active-channel-encrypted: ScrollView {
                    vertical-stretch: 1;
                    viewport-y <=> root.msg-viewport-y;
                    changed viewport-height => {
                        if (root.scroll-to-bottom) {
                            root.msg-viewport-y = -(self.viewport-height - self.visible-height);
                            root.scroll-to-bottom = false;
                        }
                    }
                    VerticalLayout {
                        padding: 4px; spacing: 0px; alignment: start;
                        for msg in root.messages: HorizontalLayout {
                            padding-left: 16px; padding-right: 16px;
                            padding-top: 6px; padding-bottom: 6px;
                            spacing: 12px;
                            Rectangle {
                                width: 36px; height: 36px; border-radius: 18px;
                                background: Palette.selection-background;
                                vertical-stretch: 0;
                                Text {
                                    text: msg.author-initial; font-weight: 700;
                                    color: Palette.foreground;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                spacing: 2px; horizontal-stretch: 1;
                                HorizontalLayout {
                                    spacing: 8px; alignment: start;
                                    Text { text: msg.author; font-weight: 700; color: Palette.accent-background; font-size: 14px; }
                                    Text { text: msg.timestamp; color: Palette.border; font-size: 11px; vertical-alignment: center; }
                                    if msg.key-version > 0: Text {
                                        text: "🔐v" + msg.key-version;
                                        color: Palette.border; font-size: 10px; vertical-alignment: center;
                                    }
                                    if msg.expires-at != "": Text {
                                        text: msg.expires-at;
                                        color: Palette.border; font-size: 10px; vertical-alignment: center;
                                    }
                                }
                                Text { text: msg.content; color: Palette.foreground; font-size: 14px; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                        }
                    }
                }

                if root.active-channel-type == "voice": Rectangle {
                    vertical-stretch: 1; background: Palette.background;
                    if !root.in-voice-channel: Text {
                        text: "Fes clic al canal per unir-te";
                        color: Palette.border; font-size: 16px; horizontal-alignment: center; vertical-alignment: center;
                    }
                    if root.in-voice-channel: ScrollView {
                        VerticalBox {
                            padding: 16px; spacing: 8px; alignment: start;
                            for p in root.voice-participants: Rectangle {
                                height: 56px;
                                border-radius: 8px;
                                background: p.is-speaking
                                    ? #22c55e33
                                    : Palette.alternate-background;
                                border-width: p.is-speaking ? 2px : 0px;
                                border-color: #22c55e;
                                HorizontalBox {
                                    padding: 8px; spacing: 10px; alignment: start;
                                    // Avatar circle
                                    Rectangle {
                                        width: 40px; height: 40px; border-radius: 20px;
                                        background: p.is-speaking ? #22c55e : Palette.border;
                                        Text {
                                            text: p.initial == "" ? "?" : p.initial;
                                            color: white; font-size: 16px; font-weight: 700;
                                            horizontal-alignment: center; vertical-alignment: center;
                                        }
                                    }
                                    // Name + state
                                    VerticalBox {
                                        spacing: 2px; alignment: center;
                                        Text {
                                            text: p.username;
                                            color: Palette.foreground; font-size: 14px; font-weight: 600;
                                        }
                                        Text {
                                            text: p.is-suppressed ? "🔇 Silenciat" : p.is-speaking ? "🎙 Parlant..." : "🎙 Micròfon actiu";
                                            color: Palette.border; font-size: 11px;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.active-channel-type == "text" && !root.active-channel-encrypted: Rectangle {
                    height: 56px; background: Palette.alternate-background;
                    HorizontalBox {
                        padding: 8px; spacing: 8px;
                        LineEdit {
                            horizontal-stretch: 1;
                            text <=> root.message-draft;
                            placeholder-text: "Escriu un missatge...";
                            enabled: root.active-channel-id != "";
                            accepted => {
                                if root.message-draft != "" {
                                    root.send-message(root.message-draft);
                                    root.message-draft = "";
                                }
                            }
                        }
                        Button {
                            text: "Enviar"; primary: true;
                            enabled: root.message-draft != "" && root.active-channel-id != "";
                            clicked => { root.send-message(root.message-draft); root.message-draft = ""; }
                        }
                    }
                }

                Rectangle {
                    height: 22px; background: Palette.background;
                    Text { x: 8px; text: root.status-text; font-size: 11px; color: Palette.border; vertical-alignment: center; }
                }
            }
        }
    }
}

# Docker Compose runtime configuration for local development
# Copy this file to .env.compose and adapt values if needed.

# PostgreSQL
POSTGRES_DB=chillgroup
POSTGRES_USER=chillgroup
POSTGRES_PASSWORD=chillgroup
DATABASE_URL=postgres://chillgroup:chillgroup@postgres:5432/chillgroup?sslmode=disable

# Backend
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
BACKEND_DEBUG=info
JWT_SECRET=change-me-in-production
SERVER_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
OPEN_REGISTER=true
TTL_CLEANUP_INTERVAL_MINUTES=5

# LiveKit (local docker compose setup)
LIVEKIT_HOST=http://host.docker.internal:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# S3-compatible storage (RustFS)
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_CONSOLE_ENABLE=true
S3_ENDPOINT=http://rustfs:9000
S3_REGION=us-east-1
S3_BUCKET=chillgroup-attachments
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfsadmin
S3_FORCE_PATH_STYLE=true

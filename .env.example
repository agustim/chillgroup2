# Servidor
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
# Nivell de logs del backend: error, warn, info, debug
BACKEND_DEBUG=info
# Nivell de logs del frontend: error, warn, info, debug
FRONTEND_DEBUG=info

# Database
DATABASE_TYPE=postgres
DATABASE_URL=postgresql://chillgroup:chillgroup@localhost:5432/chillgroup

# TTL Cleanup (minuts)
TTL_CLEANUP_INTERVAL_MINUTES=5

# LiveKit
LIVEKIT_HOST=http://localhost:7880
LIVEKIT_API_KEY=chillgroup-key
LIVEKIT_API_SECRET=chillgroup-secret

# Assistent de veu (transcripció + resum) — endpoint compatible amb OpenAI.
# Funciona amb OpenAI, o local: Whisper.cpp server, vLLM, Ollama, LM Studio.
ASSISTANT_OPENAI_BASE_URL=https://api.openai.com/v1
ASSISTANT_OPENAI_API_KEY=
ASSISTANT_STT_MODEL=whisper-1
ASSISTANT_SUMMARY_MODEL=gpt-4o-mini
# Idioma opcional (hint per Whisper): ca, es, en...
ASSISTANT_LANGUAGE=

# JWT
JWT_SECRET=chillgroup-dev-secret-key-change-in-production
JWT_EXPIRATION_DAYS=7

# Register control
OPEN_REGISTER=true
# Required when OPEN_REGISTER=false
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Server Master Key (per a encriptació simètrica - 32 bytes en hex)
# GENERAR amb: openssl rand -hex 32
SERVER_MASTER_KEY=

# Tipus de base de dades (postgres o sqlite)
DATABASE_TYPE=postgres